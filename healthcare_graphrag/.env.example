# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=healthcare_password
NEO4J_DATABASE=neo4j

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=healthcare_chunks

# ── Ingestion ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
ENTITY_CONFIDENCE_THRESHOLD=0.5

# ── Retrieval ─────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
MIN_CONFIDENCE=0.6

# ── Data ──────────────────────────────────────────────────────────────────────
DATA_DIR=data
